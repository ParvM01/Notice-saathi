{
  "manifest_version": 3,
  "name": "NoticeSaathi",
  "version": "1.0.0",
  "description": "JEE Main updates ko simple Hinglish mein samjhein.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoticeSaathi"
  }
}